{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "춘천고등학교 생기부ON",
  "version": "1.3.1",
  "identifier": "com.luminousky.school-record-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "춘천고등학교 생기부ON",
        "width": 1280,
        "height": 720,
        "resizable": false,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; connect-src ipc: http://ipc.localhost https://api.github.com; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/icon.ico": "icons/icon.ico"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2MDZEMTBBRTY5QzNBMzcKUldRM09wem1DdEVHUmk1aXVVTUNBOVV1TTJKQlBaQVN1VjZ5ZmUrNmtiRE1lUUpRUWxra05SdlUK",
      "endpoints": [
        "https://github.com/HOTS-GG/school_record_app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
